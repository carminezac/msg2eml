<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Class library hosting the whole web app (WebApp.Create): the server executable
       (Docker, systemd) and the desktop launcher are thin entry points around it. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Msg2Eml.Web</RootNamespace>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Msg2Eml.Core\Msg2Eml.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- synthetic .msg used by the health check for a real micro-conversion -->
    <EmbeddedResource Include="Resources\health.msg" LogicalName="health.msg" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Msg2Eml.Tests" />
  </ItemGroup>

</Project>
