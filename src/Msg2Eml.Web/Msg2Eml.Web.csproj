<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Msg2Eml.Web</RootNamespace>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
    <!-- No culture-specific formatting anywhere: invariant mode makes the self-contained
         binaries independent of the system ICU library. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- self-contained single-file publish settings; the RID comes from the command line -->
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <UserSecretsId>msg2eml-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Msg2Eml.Core\Msg2Eml.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- synthetic .msg used by the health check for a real micro-conversion -->
    <EmbeddedResource Include="Resources\health.msg" LogicalName="health.msg" />
  </ItemGroup>

</Project>
