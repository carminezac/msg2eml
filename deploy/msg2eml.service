# msg2eml — systemd unit for the self-contained Linux binary (no Docker, no .NET runtime).
#
#   sudo mkdir -p /opt/msg2eml && sudo tar -xzf msg2eml-server-<version>-linux-x64.tar.gz -C /opt/msg2eml --strip-components=1
#   sudo cp deploy/msg2eml.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now msg2eml
#
# The unit mirrors the container hardening: dedicated dynamic user, read-only
# filesystem, private /tmp, no new privileges, no capabilities, memory cap.

[Unit]
Description=msg2eml — Outlook .msg to .eml converter
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/msg2eml
ExecStart=/opt/msg2eml/msg2eml-server --urls http://0.0.0.0:8080
Restart=on-failure
RestartSec=5

Environment=DOTNET_EnableDiagnostics=0
Environment=Msg2Eml__MaxUploadBytes=52428800
Environment=Msg2Eml__MaxConcurrentConversions=4
Environment=Msg2Eml__RateLimitPerMinute=0
Environment=Msg2Eml__JsonLogs=true
Environment=Msg2Eml__MetricsEnabled=true

# hardening
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
MemoryMax=1G
TasksMax=256

[Install]
WantedBy=multi-user.target
